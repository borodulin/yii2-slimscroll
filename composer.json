{
    "name": "conquer/slimscroll",
    "description": "jQuery slimScroll widget for Yii2",
    "keywords": [
        "yii2",
        "extension",
        "widget",
        "slimscroll"
    ],
    "homepage": "https://github.com/borodulin/yii2-slimscroll",
    "type": "yii2-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrey Borodulin",
            "email": "borodulin@gmail.com",
            "homepage": "https://github.com/borodulin/yii2-slimscroll"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-master": "2.1.x-dev"
        }
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "yiisoft/yii2": "^2.0",
        "bower-asset/slimscroll": "~1.3.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "conquer\\slimscroll\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "conquer\\slimscroll\\tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}
